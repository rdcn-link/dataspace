# 微信公众号网页授权（扫码 /wx/login，回调 /wx/oauth）
# 须与公众平台「网页授权域名」一致（只填 fairspace.cn）
# redirect_uri 为 https://你的域名/wx/oauth（勿再用 /oidc-server/wechat/oauth，生产会 403）
VITE_WECHAT_APP_ID=REPLACE_WITH_EXTERNAL_CONFIG
# AppSecret 严禁写入前端 / VITE_ 变量，只配置在后端 oidc-server
# 生产构建写入 .env.production，见项目根目录
VITE_WECHAT_OAUTH_SCOPE=snsapi_base

# 仅在后端已实现 /oidc-server/wechat/oauth/session|report|status 时设为 true（否则不要开，避免 403）
# VITE_WECHAT_OAUTH_SERVER_SESSION=false

# 手机微信扫码必须用公网 HTTPS 域名（不能用 localhost）
# 本地开发可用 cpolar/ngrok 穿透，或直接用生产地址：
# VITE_APP_PUBLIC_URL=https://fairspace.cn

# 开发代理（可选）
VITE_WECHAT_API_BASE=https://fairspace.cn
# AGUI 对话接口代理目标（/tds-agent/agui/run）
VITE_AGUI_API_BASE=https://fairspace.cn
# 资讯正文 HTML 代理（开发由 Vite 插件提供；生产需 Nginx 反代 scripts/article-html-proxy.mjs）
# VITE_ARTICLE_HTML_PROXY=/api/article-html
