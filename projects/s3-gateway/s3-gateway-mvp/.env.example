# S3 Gateway MVP 环境变量配置

# S3 认证配置
S3_ACCESS_KEY=tpdc-access
S3_SECRET_KEY=change-me
S3_REGION=us-east-1

# 服务配置
S3_HOST=0.0.0.0
S3_PORT=9000

# 数据库配置
S3_DB_PATH=/app/data/s3_gateway.db

# 数据根目录（容器内挂载路径）
S3_DATA_ROOT=/data

# 默认 Bucket
S3_BUCKET_NAME=tpdc-bucket

# Bucket Owner 信息
S3_OWNER_ID=tpdc-owner
S3_OWNER_DISPLAY_NAME=tpdc

# 分页配置
S3_MAX_KEYS=1000

# 认证开关（测试时可设为 false 跳过签名验证）
S3_ENABLE_AUTH=true

# 日志级别
S3_LOG_LEVEL=INFO